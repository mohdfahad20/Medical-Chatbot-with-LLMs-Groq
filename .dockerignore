# Git files
.git
.gitignore
.gitattributes
.github

# Python cache and compiled files
__pycache__/
*.py[codz]
*$py.class
*.so
*.pyc
*.pyo
**/__pycache__/
src/__pycache__/

# Virtual environments (CRITICAL!)
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment variables
.env
.envrc

# IDE files
.vscode/
.idea/
*.swp
*.swo
*.swn
.DS_Store
Thumbs.db

# Documentation (not needed in container)
README.md
README_HF.md
LICENSE

# Docker files (don't need these inside the image)
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.yaml

# Archive and research folders (IMPORTANT - can be large!)
archive/
research/
trials.ipynb

# Old/backup files
static/
templates/
app_fastapi_backup.py
requirements_fastapi.txt
setup.py
store_index.py
template.sh
render.yaml

# Database files (will be created at runtime)
rate_limits.db
*.db
*.sqlite
*.sqlite3

# Testing and notebooks
*.ipynb
.ipynb_checkpoints/
.pytest_cache/
.coverage

# Logs
*.log
pip-log.txt

# Build artifacts
build/
dist/
*.egg-info/

# Streamlit secrets (use env vars instead)
.streamlit/secrets.toml

# Other temporary files
*.tmp
*.bak
.cache/